  </main>  </div>  <script>  
/* =========================================================  
   LUNARO CONFIG  
========================================================= */  
  
const API_URL =  
  "https://lunaro-api.alikoms15.workers.dev";  
  
/*  
  IMPORTANT:  
  Replace this with the real Telegram bot username  
  when your bot username is finalized.  
*/  
const BOT_USERNAME =  
  "YOUR_BOT_USERNAME";  
  
/*  
  IMPORTANT:  
  This must point to the tonconnect-manifest.json  
  that exists in your GitHub Pages repository.  
*/  
const MANIFEST_URL =  
  "https://alikoms15-lab.github.io/alikoms15.github.io/tonconnect-manifest.json";  
  
  
/* =========================================================  
   TELEGRAM  
========================================================= */  
  
const tg =  
  window.Telegram?.WebApp || null;  
  
  
/* =========================================================  
   TON CONNECT  
========================================================= */  
  
let tonConnectUI = null;  
let tonReady = false;  
let restoringWallet = true;  
  
  
/* =========================================================  
   LOCAL STATE  
========================================================= */  
  
const STORAGE_KEY =  
  "lunaro_v7_state";  
  
const defaultState = {  
  
  pool: 0,  
  
  holding: null,  
  
  mined: 0,  
  
  lastMiningTime: Date.now(),  
  
  telegramName: "",  
  
  telegramId: "",  
  
  username: "",  
  
  level: 1,  
  
  rate: 0.7000,  
  
  referralCode: "LNR000000",  
  
  friends: 0,  
  
  refRewards: 0,  
  
  history: [],  
  
  dailyClaimDate: ""  
  
};  
  
let state =  
  loadState();  
  
  
/*  
  This variable represents an ACTUAL TON Connect  
  session, not a fake wallet address.  
*/  
let connectedWallet = null;  
  
  
/*  
  Used to prevent excessive localStorage writes.  
*/  
let lastSavedMining = 0;  
  
  
/* =========================================================  
   HELPERS  
========================================================= */  
  
function loadState(){  
  
  try{  
  
    const raw =  
      localStorage.getItem(  
        STORAGE_KEY  
      );  
  
    if(!raw){  
  
      return {  
  
        ...defaultState,  
  
        lastMiningTime:  
          Date.now()  
  
      };  
  
    }  
  
    const saved =  
      JSON.parse(raw);  
  
    return {  
  
      ...defaultState,  
  
      ...saved  
  
    };  
  
  }catch(error){  
  
    console.error(  
      "State load error:",  
      error  
    );  
  
    return {  
  
      ...defaultState,  
  
      lastMiningTime:  
        Date.now()  
  
    };  
  
  }  
  
}  
  
  
function saveState(){  
  
  try{  
  
    localStorage.setItem(  
      STORAGE_KEY,  
      JSON.stringify(state)  
    );  
  
  }catch(error){  
  
    console.error(  
      "State save error:",  
      error  
    );  
  
  }  
  
}  
  
  
function fmt(value){  
  
  const n =  
    Number(value || 0);  
  
  return n.toFixed(4);  
  
}  
  
  
function shortAddress(address){  
  
  if(!address){  
    return "";  
  }  
  
  if(address.length <= 18){  
    return address;  
  }  
  
  return (  
  
    address.slice(0,7) +  
  
    "..." +  
  
    address.slice(-6)  
  
  );  
  
}  
  
  
function showToast(message){  
  
  const el =  
    document.getElementById(  
      "toast"  
    );  
  
  el.textContent =  
    message;  
  
  el.classList.add(  
    "show"  
  );  
  
  clearTimeout(  
    showToast.timer  
  );  
  
  showToast.timer =  
    setTimeout(()=>{  
  
      el.classList.remove(  
        "show"  
      );  
  
    },2300);  
  
}  
  
  
/* =========================================================  
   TELEGRAM INIT  
========================================================= */  
  
function initTelegram(){  
  
  if(!tg){  
  
    console.log(  
      "LUNARO is running outside Telegram"  
    );  
  
    state.telegramId =  
      state.telegramId ||  
      "demo-user";  
  
    state.telegramName =  
      state.telegramName ||  
      "Demo User";  
  
    updateUI();  
  
    return;  
  
  }  
  
  try{  
  
    tg.ready();  
  
    tg.expand();  
  
    const user =  
      tg.initDataUnsafe?.user;  
  
    if(user){  
  
      state.telegramId =  
        String(  
          user.id || ""  
        );  
  
      state.username =  
        user.username || "";  
  
      state.telegramName =  
        user.username  
          ? `${user.first_name || "User"} @${user.username}`  
          : (  
              user.first_name ||  
              "User"  
            );  
  
      saveState();  
  
      updateUI();  
  
    }  
  
  }catch(error){  
  
    console.error(  
      "Telegram init error:",  
      error  
    );  
  
  }  
  
}  
  
  
/* =========================================================  
   TON CONNECT INIT  
========================================================= */  
  
async function initTonConnect(){  
  
  try{  
  
    if(  
      !window.TON_CONNECT_UI ||  
      !window.TON_CONNECT_UI.TonConnectUI  
    ){  
  
      throw new Error(  
        "TON Connect library failed to load."  
      );  
  
    }  
  
    tonConnectUI =  
      new TON_CONNECT_UI.TonConnectUI({  
  
        manifestUrl:  
          MANIFEST_URL,  
  
        restoreConnection:  
          true  
  
      });  
  
  
    /*  
      Listen for wallet changes.  
    */  
  
    tonConnectUI.onStatusChange(  
  
      wallet => {  
  
        if(  
          wallet &&  
          wallet.account  
        ){  
  
          const address =  
            wallet.account.address;  
  
          const changedWallet =  
            connectedWallet !==  
            address;  
  
          connectedWallet =  
            address;  
  
          /*  
            During restoration we don't reset  
            the mining timer.  
  
            If user manually changes wallet,  
            timer starts from the new connection.  
          */  
  
          setConnectedWallet(  
  
            address,  
  
            !restoringWallet &&  
            changedWallet  
  
          );  
  
        }else{  
  
          connectedWallet =  
            null;  
  
          setConnectedWallet(  
            null,  
            false  
          );  
  
        }  
  
      }  
  
    );  
  
  
    /*  
      Wait until TON Connect attempts  
      to restore previous connection.  
    */  
  
    try{  
  
      await tonConnectUI.connectionRestored;  
  
    }catch(error){  
  
      console.warn(  
        "Wallet restoration warning:",  
        error  
      );  
  
    }  
  
    restoringWallet =  
      false;  
  
    tonReady =  
      true;  
  
  
    /*  
      Read wallet after restoration.  
    */  
  
    const wallet =  
      tonConnectUI.wallet;  
  
    if(  
      wallet &&  
      wallet.account  
    ){  
  
      const address =  
        wallet.account.address;  
  
      connectedWallet =  
        address;  
  
      setConnectedWallet(  
        address,  
        false  
      );  
  
    }else{  
  
      connectedWallet =  
        null;  
  
      setConnectedWallet(  
        null,  
        false  
      );  
  
    }  
  
    updateWalletUI();  
  
  }catch(error){  
  
    restoringWallet =  
      false;  
  
    tonReady =  
      false;  
  
    console.error(  
      "TON Connect initialization error:",  
      error  
    );  
  
    updateWalletUI();  
  
    showToast(  
      "TON wallet connection is not ready."  
    );  
  
  }  
  
}  
  
  
/* =========================================================  
   WALLET STATE  
========================================================= */  
  
function setConnectedWallet(  
  
  address,  
  
  resetMiningTime = true  
  
){  
  
  const previous =  
    connectedWallet;  
  
  connectedWallet =  
    address || null;  
  
  
  if(  
    connectedWallet &&  
    resetMiningTime  
  ){  
  
    /*  
      Don't lose mined amount accumulated  
      before the wallet switch.  
    */  
  
    state.lastMiningTime =  
      Date.now();  
  
  }  
  
  
  if(!connectedWallet){  
  
    /*  
      Stop mining clock while disconnected.  
    */  
  
    state.lastMiningTime =  
      Date.now();  
  
  }  
  
  saveState();

  updateWalletUI();
  updateUI();

  if(connectedWallet){
    startMiningSync();
  }else{
    stopMiningSync();
  }

}  
  
  
/* =========================================================  
   WALLET UI  
========================================================= */  
  
function updateWalletUI(){  
  
  const headerText =  
    document.getElementById(  
      "walletHeaderText"  
    );  
  
  const walletDot =  
    document.getElementById(  
      "walletDot"  
    );  
  
  const panelAddress =  
    document.getElementById(  
      "walletPanelAddress"  
    );  
  
  const connectButton =  
    document.getElementById(  
      "walletConnectButton"  
    );  
  
  const disconnectButton =  
    document.getElementById(  
      "walletDisconnectButton"  
    );  
  
  
  if(connectedWallet){  
  
    if(headerText){  
  
      headerText.textContent =  
        shortAddress(  
          connectedWallet  
        );  
  
    }  
  
    if(walletDot){  
  
      walletDot.classList.remove(  
        "off"  
      );  
  
    }  
  
    if(panelAddress){  
  
      panelAddress.textContent =  
        connectedWallet;  
  
    }  
  
    if(connectButton){  
  
      connectButton.textContent =  
        "CHANGE WALLET";  
  
    }  
  
    if(disconnectButton){  
  
      disconnectButton.style.display =  
        "block";  
  
    }  
  
  }else{  
  
    if(headerText){  
  
      headerText.textContent =  
        "Connect Wallet";  
  
    }  
  
    if(walletDot){  
  
      walletDot.classList.add(  
        "off"  
      );  
  
    }  
  
    if(panelAddress){  
  
      panelAddress.textContent =  
        "No wallet connected";  
  
    }  
  
    if(connectButton){  
  
      connectButton.textContent =  
        "CONNECT WALLET";  
  
    }  
  
    if(disconnectButton){  
  
      disconnectButton.style.display =  
        "none";  
  
    }  
  
  }  
  
}  
  
  
/* =========================================================  
   OPEN WALLET  
========================================================= */  
  
function toggleWalletPanel(){  
  
  const panel =  
    document.getElementById(  
      "walletPanel"  
    );  
  
  const overlay =  
    document.getElementById(  
      "overlay"  
    );  
  
  
  if(  
    panel.classList.contains(  
      "show"  
    )  
  ){  
  
    closeWalletPanel();  
  
  }else{  
  
    panel.classList.add(  
      "show"  
    );  
  
    overlay.classList.add(  
      "show"  
    );  
  
  }  
  
}  
  
  
function closeWalletPanel(){  
  
  document  
    .getElementById(  
      "walletPanel"  
    )  
    .classList.remove(  
      "show"  
