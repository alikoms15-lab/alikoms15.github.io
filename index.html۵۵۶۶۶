/* =========================================================  
   MAIN MINING LOOP  
========================================================= */  
  
let lastFrame =  
  Date.now();  
  
let lastRender =  
  0;  
  
  
function miningLoop(){  
  
  const now =  
    Date.now();  
  
  
  /*
    Mining is calculated and persisted by Worker/D1.
  */  
  
  
  /*  
    Render frequently enough for  
    4 decimal places to visibly move.  
  */  
  
  if(  
  
    now -  
    lastRender >=  
    100  
  
  ){  
  
    updateUI();  
  
    lastRender =  
      now;  
  
  }  
  
  
  requestAnimationFrame(  
    miningLoop  
  );  
  
}  
  
  
/* =========================================================  
   START  
========================================================= */  
  
async function startApp(){  
  
  initTelegram();  
  
  await loadUser();  
  
  updateUI();  
  
  renderMinerGrid();  
  
  updateWalletUI();  
  
  
  /*  
    Start visual loop immediately.  
  */  
  
  requestAnimationFrame(  
    miningLoop  
  );  
  
  
  /*  
    Then initialize actual TON Connect.  
  */  
  
  await initTonConnect();  
  
  updateUI();  
  
}  
  
  
/* =========================================================  
   RUN  
========================================================= */  
  
startApp();  
  
