========================================================= */  
  
function showPage(page){  
  
  const pages =  
    document.querySelectorAll(  
      ".page"  
    );  
  
  
  pages.forEach(  
  
    item => {  
  
      item.classList.remove(  
        "active"  
      );  
  
    }  
  
  );  
  
  
  const target =  
    document.getElementById(  
      "page-" +  
      page  
    );  
  
  
  if(target){  
  
    target.classList.add(  
      "active"  
    );  
  
  }  
  
  
  const navItems =  
    document.querySelectorAll(  
      ".nav-item"  
    );  
  
  
  navItems.forEach(  
  
    item => {  
  
      item.classList.toggle(  
  
        "active",  
  
        item.dataset.page ===  
        page  
  
      );  
  
    }  
  
  );  
  
  
  window.scrollTo({  
  
    top:0,  
  
    behavior:"smooth"  
  
  });  
  
  
  if(page === "miners"){  
  
    renderMinerGrid();  
  
  }  
  
}  
  
  
/* =========================================================  
   DAILY TASK  
========================================================= */  
  
function todayKey(){  
  
  const d =  
    new Date();  
  
  
  return [  
  
    d.getFullYear(),  
  
    String(  
      d.getMonth()+1  
    ).padStart(  
      2,  
      "0"  
    ),  
  
    String(  
      d.getDate()  
    ).padStart(  
      2,  
      "0"  
    )  
  
  ].join("-");  
  
}  
  
  
function completeDailyTask(){  
  
  const today =  
    todayKey();  
  
  
  if(  
    state.dailyClaimDate ===  
    today  
  ){  
  
    showToast(  
      "Daily reward already claimed."  
    );  
  
    return;  
  
  }  
  
  
  state.pool =  
    Number(  
      state.pool || 0  
    ) +  
    3;  
  
  
  state.dailyClaimDate =  
    today;  
  
  
  saveState();  
  
  updateUI();  
  
  showToast(  
    "+3 LNR daily reward"  
  );  
  
}  
  
  
function updateDailyTaskUI(){  
  
  const btn =  
    document.getElementById(  
      "dailyTaskBtn"  
    );  
  
  
  if(!btn){  
  
    return;  
  
  }  
  
  
  if(  
    state.dailyClaimDate ===  
    todayKey()  
  ){  
  
    btn.textContent =  
      "DONE";  
  
    btn.classList.add(  
      "done"  
    );  
  
    btn.disabled =  
      true;  
  
  }else{  
  
    btn.textContent =  
      "CLAIM";  
  
    btn.classList.remove(  
      "done"  
    );  
  
    btn.disabled =  
      false;  
  
  }  
  
}  
  
  
