/* =========================================================  
   DISCONNECT WALLET  
========================================================= */  
  
async function disconnectWallet(){  
  
  if(!tonConnectUI){  
    return;  
  }  
  
  try{  
  
    await syncMiningFromServer();
    stopMiningSync();

    await tonConnectUI.disconnect();  
  
    connectedWallet =  
      null;  
  
    state.lastMiningTime =  
      Date.now();  
  
    saveState();  
  
    updateWalletUI();  
  
    updateUI();  
  
    closeWalletPanel();  
  
    showToast(  
      "Wallet disconnected."  
    );  
  
  }catch(error){  
  
    console.error(  
      "Disconnect error:",  
      error  
    );  
  
    showToast(  
      "Could not disconnect wallet."  
    );  
  
  }  
  
}  
  
  
/* =========================================================  
   MINING  
========================================================= */  
  
let miningSyncTimer = null;
let miningSyncBusy = false;

async function syncMiningFromServer(){
  if(miningSyncBusy || !connectedWallet || !state.telegramId) return;
  miningSyncBusy = true;
  try{
    const response = await fetch(API_URL + "/mine", {
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({telegram_id:state.telegramId, wallet:connectedWallet})
    });
    const data = await response.json();
    if(response.ok && data.success && data.user){
      applyServerUser(data.user);
      saveState();
      updateUI();
    }else{
      console.warn("Mining sync rejected:", data);
    }
  }catch(error){
    console.warn("Mining sync failed:", error);
  }finally{
    miningSyncBusy = false;
  }
}

function applyServerUser(user){
  state.pool = Number(user.balance ?? state.pool ?? 0);
  state.mined = Number(user.mined ?? state.mined ?? 0);
  state.level = Number(user.level ?? state.level ?? 1);
  state.rate = Number(user.mining_rate ?? state.rate ?? 0.7);
  if(user.referral_code) state.referralCode = user.referral_code;
}

async function loadUser(){
  if(!state.telegramId) return false;
  try{
    const response = await fetch(API_URL + "/user", {
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        telegram_id: state.telegramId,
        username: state.username || null,
        first_name: (state.telegramName || "User").split(" @")[0],
        wallet: connectedWallet || null
      })
    });
    const data = await response.json();
    if(response.ok && data.success && data.user){
      applyServerUser(data.user);
      saveState();
      updateUI();
      return true;
    }
    console.warn("User load rejected:", data);
  }catch(error){
    console.warn("User load failed:", error);
  }
  return false;
}

function startMiningSync(){
  if(miningSyncTimer) clearInterval(miningSyncTimer);
  miningSyncTimer = setInterval(syncMiningFromServer, 20000);
  syncMiningFromServer();
}

function stopMiningSync(){
  if(miningSyncTimer){
    clearInterval(miningSyncTimer);
    miningSyncTimer = null;
  }
}

/* =========================================================
   CLAIM
========================================================= */

async function claimMining(){
  if(!connectedWallet){
    showToast("Connect your TON wallet first.");
    return;
  }
  if(!state.telegramId){
    showToast("Telegram account is not ready yet.");
    return;
  }

  const btn = document.getElementById("claimBtn");
  if(btn) btn.disabled = true;

  try{
    await syncMiningFromServer();

    const response = await fetch(API_URL + "/claim", {
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({telegram_id:state.telegramId, wallet:connectedWallet})
    });
    const data = await response.json();

    if(!response.ok || !data.success || !data.user){
      throw new Error(data.error || "Claim failed");
    }

    const claimed = Number(data.claimed || 0);
    applyServerUser(data.user);
    state.lastMiningTime = Date.now();
    saveState();
    updateUI();
    showToast(`Claimed ${fmt(claimed)} LNR`);
  }catch(error){
    console.error("Claim error:", error);
    showToast(error.message || "Claim failed. Please try again.");
    updateUI();
  }
}


/* =========================================================
   LEVEL SYSTEM
========================================================= */  
  
function levelThreshold(level){  
  
  if(level <= 1){  
  
    return 0;  
  
  }  
  
  return 100 *  
    Math.pow(  
      level - 1,  
      1.35  
    );  
  
}  
  
  
function levelRate(level){  
  
  return (  
    0.70 +  
    (level - 1) *  
    0.05  
  );  
  
}  
  
  
function updateLevel(){  
  
  /*  
    Level is based on claimed balance  
    in this prototype.  
  */  
  
  const balance =  
    Number(  
      state.pool || 0  
    );  
  
  let level =  
    1;  
  
  
  for(  
    let i=2;  
    i<=100;  
    i++  
  ){  
  
    if(  
      balance >=  
      levelThreshold(i)  
    ){  
  
      level =  
        i;  
  
    }else{  
  
      break;  
  
    }  
  
  }  
  
  
  state.level =  
    level;  
  
  state.rate =  
    levelRate(level);  
  
}  
  
  
