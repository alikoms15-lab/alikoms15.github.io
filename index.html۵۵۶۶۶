<!DOCTYPE html>  <html lang="en">  
<head>  
<meta charset="UTF-8">  
<meta name="viewport"  
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">  
<title>LUNARO — Automatic Mining</title>  
<script src="https://telegram.org/js/telegram-web-app.js"></script>  
<script src="https://unpkg.com/@tonconnect/ui@latest/dist/tonconnect-ui.min.js"></script>  
<style>  
:root{  
  --bg:#eef3f0;  
  --card:#ffffff;  
  --ink:#10211c;  
  --muted:#718078;  
  --line:#dce5e0;  
  --green:#169866;  
  --green2:#08734d;  
  --green3:#0d5c43;  
  --dark:#10251f;  
  --dark2:#16352b;  
  --dark3:#1b4235;  
  --soft:#e2f2eb;  
  --soft2:#d5ebe1;  
  --gold:#c89b38;  
  --danger:#d9534f;  
  --shadow:0 10px 28px rgba(16,37,31,.08);  
  --radius:20px;  
}  
*{  
  box-sizing:border-box;  
  -webkit-tap-highlight-color:transparent;  
}  
html,body{  
  margin:0;  
  padding:0;  
  width:100%;  
  min-height:100%;  
  background:var(--bg);  
  color:var(--ink);  
  font-family:  
    Inter,  
    -apple-system,  
    BlinkMacSystemFont,  
    "Segoe UI",  
    Roboto,  
    Arial,  
    sans-serif;  
}  
body{  
  overflow-x:hidden;  
}  
button{  
  font:inherit;  
  border:0;  
  cursor:pointer;  
}  
button:disabled{  
  cursor:not-allowed;  
  opacity:.55;  
}  
.app{  
  width:100%;  
  max-width:520px;  
  min-height:100vh;  
  margin:0 auto;  
  padding:10px 12px 88px;  
}  
/* =========================  
   HEADER  
========================= */  
.header{  
  height:52px;  
  display:flex;  
  align-items:center;  
  justify-content:space-between;  
  gap:8px;  
}  
.brand{  
  display:flex;  
  align-items:center;  
  gap:9px;  
  min-width:0;  
}  
.brand-logo{  
  width:36px;  
  height:36px;  
  border-radius:12px;  
  background:linear-gradient(145deg,var(--green),var(--green3));  
  color:#fff;  
  display:flex;  
  align-items:center;  
  justify-content:center;  
  font-size:20px;  
  font-weight:900;  
  box-shadow:0 7px 18px rgba(22,152,102,.25);  
}  
.brand-text{  
  min-width:0;  
}  
.brand-name{  
  font-size:15px;  
  font-weight:900;  
  letter-spacing:.2px;  
  line-height:1;  
}  
.brand-sub{  
  margin-top:4px;  
  color:var(--muted);  
  font-size:8px;  
  font-weight:800;  
  letter-spacing:1.2px;  
}  
.header-right{  
  display:flex;  
  align-items:center;  
  gap:7px;  
}  
.level-pill{  
  height:36px;  
  min-width:64px;  
  padding:0 10px;  
  border-radius:12px;  
  background:#fff;  
  border:1px solid var(--line);  
  display:flex;  
  flex-direction:column;  
  justify-content:center;  
  box-shadow:var(--shadow);  
}  
.level-pill-label{  
  font-size:8px;  
  font-weight:800;  
  color:var(--muted);  
}  
.level-pill-value{  
  font-size:13px;  
  font-weight:900;  
  color:var(--green3);  
  margin-top:2px;  
}  
.wallet-mini{  
  height:36px;  
  padding:0 11px;  
  border-radius:12px;  
  background:var(--dark);  
  color:#fff;  
  display:flex;  
  align-items:center;  
  gap:6px;  
  box-shadow:var(--shadow);  
  max-width:150px;  
}  
.wallet-dot{  
  width:7px;  
  height:7px;  
  border-radius:50%;  
  background:#54dca2;  
  box-shadow:0 0 8px rgba(84,220,162,.8);  
  flex:none;  
}  
.wallet-mini-text{  
  overflow:hidden;  
  white-space:nowrap;  
  text-overflow:ellipsis;  
  font-size:10px;  
  font-weight:800;  
}  
/* =========================  
   PAGES  
========================= */  
.page{  
  display:none;  
}  
.page.active{  
  display:block;  
}  
/* =========================  
   HOME  
========================= */  
.home{  
  padding-top:3px;  
}  
/* compact hero */  
.hero{  
  position:relative;  
  height:165px;  
  margin-top:4px;  
  border-radius:26px;  
  overflow:hidden;  
  background:  
    radial-gradient(circle at 50% 48%, rgba(22,152,102,.13), transparent 42%),  
    linear-gradient(180deg,#f8fbf9,#e8f1ed);  
  border:1px solid #dce8e2;  
  display:flex;  
  align-items:center;  
  justify-content:center;  
}  
.hero::before{  
  content:"";  
  position:absolute;  
  width:145px;  
  height:145px;  
  border:1px solid rgba(22,152,102,.16);  
  border-radius:50%;  
}  
.hero::after{  
  content:"";  
  position:absolute;  
  width:205px;  
  height:55px;  
  border:1px solid rgba(22,152,102,.15);  
  border-radius:50%;  
  transform:rotate(-17deg);  
}  
.orbit{  
  position:absolute;  
  width:220px;  
  height:65px;  
  border:2px solid rgba(22,152,102,.32);  
  border-radius:50%;  
  transform:rotate(-20deg);  
}  
.orbit.two{  
  width:175px;  
  height:50px;  
  transform:rotate(24deg);  
  border-color:rgba(13,92,67,.18);  
}  
.lnr-crystal{  
  position:relative;  
  width:94px;  
  height:94px;  
  z-index:3;  
  transform:rotate(45deg);  
  border-radius:22px;  
  background:  
    linear-gradient(135deg,  
      #e5f7ee 0%,  
      #a7dcc3 22%,  
      #169866 49%,  
      #08734d 72%,  
      #0d5c43 100%);  
  box-shadow:  
    0 16px 30px rgba(8,115,77,.28),  
    inset 4px 4px 8px rgba(255,255,255,.55),  
    inset -8px -8px 14px rgba(0,0,0,.15);  
}  
.lnr-crystal::before{  
  content:"";  
  position:absolute;  
  inset:12px;  
  border-radius:14px;  
  border:1px solid rgba(255,255,255,.45);  
}  
.lnr-crystal::after{  
  content:"";  
  position:absolute;  
  width:35px;  
  height:35px;  
  top:9px;  
  left:9px;  
  border-radius:9px;  
  background:rgba(255,255,255,.22);  
}  
.lnr-letter{  
  position:absolute;  
  inset:0;  
  display:flex;  
  align-items:center;  
  justify-content:center;  
  transform:rotate(-45deg);  
  color:#fff;  
  font-size:27px;  
  font-weight:1000;  
  letter-spacing:-2px;  
  text-shadow:0 3px 8px rgba(0,0,0,.22);  
}  
.hero-caption{  
  position:absolute;  
  bottom:10px;  
  left:0;  
  right:0;  
  text-align:center;  
  font-size:8px;  
  font-weight:900;  
  letter-spacing:2px;  
  color:var(--green3);  
}  
/* mining status */  
.mining-status{  
  margin-top:8px;  
  height:30px;  
  border-radius:12px;  
  background:#fff;  
  border:1px solid var(--line);  
  display:flex;  
  align-items:center;  
  justify-content:center;  
  gap:7px;  
  color:var(--green3);  
  font-size:9px;  
  font-weight:900;  
  letter-spacing:.5px;  
}  
.status-dot{  
  width:7px;  
  height:7px;  
  border-radius:50%;  
  background:#28bd78;  
  box-shadow:0 0 9px rgba(40,189,120,.7);  
}  
.status-dot.off{  
  background:#a3aaa6;  
  box-shadow:none;  
}  
/* total */  
.total-card{  
  margin-top:8px;  
  padding:12px 15px;  
  min-height:82px;  
  border-radius:19px;  
  background:linear-gradient(145deg,var(--dark),var(--dark3));  
  color:#fff;  
  box-shadow:0 13px 28px rgba(16,37,31,.16);  
}  
.total-label{  
  font-size:8px;  
  letter-spacing:1.5px;  
  font-weight:900;  
  opacity:.65;  
}  
.total-row{  
  display:flex;  
  align-items:end;  
  justify-content:space-between;  
  gap:10px;  
  margin-top:3px;  
}  
.total-number{  
  font-size:28px;  
  line-height:1;  
  font-weight:950;  
  letter-spacing:-1px;  
}  
.total-token{  
  font-size:10px;  
  font-weight:900;  
  color:#8ee0bc;  
  padding-bottom:2px;  
}  
/* balance cards */  
.balance-grid{  
  display:grid;  
  grid-template-columns:1fr 1fr;  
  gap:8px;  
  margin-top:8px;  
}  
.balance-card{  
  min-height:66px;  
  padding:10px 11px;  
  border-radius:17px;  
  background:#fff;  
  border:1px solid var(--line);  
  box-shadow:var(--shadow);  
}  
.balance-title{  
  display:flex;  
  align-items:center;  
  gap:6px;  
  color:var(--muted);  
  font-size:8px;  
  font-weight:800;  
}  
.balance-icon{  
  width:22px;  
  height:22px;  
  border-radius:8px;  
  display:flex;  
  align-items:center;  
  justify-content:center;  
  background:var(--soft);  
  color:var(--green3);  
  font-size:11px;  
  font-weight:900;  
}  
.balance-value{  
  margin-top:7px;  
  font-size:17px;  
  font-weight:950;  
  letter-spacing:-.3px;  
}  
.balance-unit{  
  color:var(--muted);  
  font-size:8px;  
  font-weight:800;  
}  
/* mined card */  
.mined-card{  
  margin-top:8px;  
  min-height:102px;  
  padding:13px 15px;  
  border-radius:20px;  
  background:  
    linear-gradient(145deg,#ffffff,#f4faf7);  
  border:1px solid #cfe4da;  
  box-shadow:  
    0 12px 28px rgba(16,37,31,.08),  
    inset 0 1px 0 rgba(255,255,255,.9);  
  display:flex;  
  align-items:center;  
  justify-content:space-between;  
  gap:12px;  
}  
.mined-left{  
  min-width:0;  
}  
.mined-title{  
  color:var(--green3);  
  font-size:9px;  
  font-weight:950;  
  letter-spacing:.7px;  
  text-transform:uppercase;  
}  
.mined-sub{  
  margin-top:4px;  
  color:var(--muted);  
  font-size:8px;  
  font-weight:700;  
}  
.mined-right{  
  text-align:right;  
  flex:none;  
}  
.mined-number{  
  font-size:28px;  
  line-height:1;  
  font-weight:950;  
  letter-spacing:-1px;  
  color:var(--green2);  
  font-variant-numeric:tabular-nums;  
}  
.mined-unit{  
  margin-top:4px;  
  font-size:8px;  
  font-weight:900;  
  color:var(--muted);  
}  
/* claim */  
.claim-btn{  
  width:100%;  
  height:47px;  
  margin-top:8px;  
  border-radius:16px;  
  background:linear-gradient(135deg,var(--green),var(--green2));  
  color:#fff;  
  font-size:13px;  
  font-weight:950;  
  letter-spacing:.3px;  
  box-shadow:  
    0 10px 22px rgba(22,152,102,.23),  
    inset 0 1px 0 rgba(255,255,255,.22);  
  transition:.18s ease;  
}  
.claim-btn:active{  
  transform:scale(.985);  
}  
.claim-btn:disabled{  
  background:#cbd7d1;  
  color:#fff;  
  box-shadow:none;  
}  
/* info */  
.info-card{  
  margin-top:8px;  
  min-height:57px;  
  border-radius:17px;  
  background:var(--dark);  
  color:#fff;  
  padding:9px 11px;  
  display:flex;  
  align-items:center;  
  gap:10px;  
}  
.info-logo{  
  width:35px;  
  height:35px;  
  border-radius:11px;  
  background:linear-gradient(145deg,var(--green),var(--green3));  
  display:flex;  
  align-items:center;  
  justify-content:center;  
  font-size:17px;  
  font-weight:950;  
  flex:none;  
}  
.info-content{  
  min-width:0;  
}  
.info-title{  
  font-size:10px;  
  font-weight:950;  
}  
.info-text{  
  margin-top:3px;  
  font-size:8px;  
  color:#b9c9c2;  
  font-weight:700;  
}  
/* =========================  
   SECTION  
========================= */  
.section-title{  
  margin:9px 2px 7px;  
  display:flex;  
  justify-content:space-between;  
  align-items:center;  
}  
.section-title h2{  
  margin:0;  
  font-size:15px;  
  font-weight:950;  
}  
.section-title span{  
  font-size:8px;  
  color:var(--muted);  
  font-weight:800;  
}  
/* =========================  
   TASKS  
========================= */  
.task-list{  
  display:grid;  
  gap:8px;  
}  
.task-card{  
  min-height:67px;  
  background:#fff;  
  border:1px solid var(--line);  
  border-radius:17px;  
  padding:10px;  
  display:flex;  
  align-items:center;  
  gap:10px;  
  box-shadow:var(--shadow);  
}  
.task-icon{  
  width:38px;  
  height:38px;  
  border-radius:12px;  
  background:var(--soft);  
  display:flex;  
  align-items:center;  
  justify-content:center;  
  font-size:17px;  
  flex:none;  
}  
.task-content{  
  flex:1;  
  min-width:0;  
}  
.task-name{  
  font-size:10px;  
  font-weight:900;  
}  
.task-reward{  
  margin-top:3px;  
  font-size:8px;  
  color:var(--green2);  
  font-weight:800;  
}  
.task-btn{  
  min-width:68px;  
  height:31px;  
  border-radius:10px;  
  background:var(--green);  
  color:#fff;  
  font-size:9px;  
  font-weight:900;  
}  
.task-btn.done{  
  background:var(--soft2);  
  color:var(--green3);  
}  
/* =========================  
   MINERS  
========================= */  
.miner-summary{  
  background:linear-gradient(145deg,var(--dark),var(--dark3));  
  color:#fff;  
  border-radius:19px;  
  padding:13px;  
  box-shadow:var(--shadow);  
}  
.miner-summary-label{  
  font-size:8px;  
  opacity:.65;  
  font-weight:900;  
}  
.miner-summary-row{  
  display:flex;  
  align-items:end;  
  justify-content:space-between;  
  margin-top:5px;  
}  
.miner-summary-level{  
  font-size:25px;  
  font-weight:950;  
}  
.miner-summary-rate{  
  font-size:10px;  
  color:#8ee0bc;  
  font-weight:900;  
}  
.miner-grid{  
  margin-top:8px;  
  display:grid;  
  grid-template-columns:1fr 1fr;  
  gap:7px;  
}  
.miner-card{  
  background:#fff;  
  border:1px solid var(--line);  
  border-radius:16px;  
  padding:10px;  
  min-height:87px;  
  box-shadow:var(--shadow);  
}  
.miner-card.current{  
  border-color:#7ac6a5;  
  box-shadow:0 8px 22px rgba(22,152,102,.12);  
}  
.miner-level{  
  font-size:10px;  
  font-weight:950;  
}  
.miner-rate{  
  margin-top:5px;  
  font-size:13px;  
  color:var(--green2);  
  font-weight:950;  
}  
.miner-hold{  
  margin-top:4px;  
  color:var(--muted);  
  font-size:7px;  
  font-weight:700;  
}  
/* =========================  
   FRIENDS  
========================= */  
.ref-card{  
  background:linear-gradient(145deg,var(--dark),var(--dark3));  
  color:#fff;  
  border-radius:20px;  
  padding:15px;  
  box-shadow:var(--shadow);  
}  
.ref-label{  
  font-size:8px;  
  color:#a9bdb5;  
  font-weight:900;  
  letter-spacing:1px;  
}  
.ref-code{  
  margin-top:7px;  
  font-size:23px;  
  font-weight:950;  
  letter-spacing:1px;  
}  
.ref-copy{  
  margin-top:9px;  
  width:100%;  
  height:39px;  
  border-radius:12px;  
  background:var(--green);  
  color:#fff;  
  font-size:10px;  
  font-weight:900;  
}  
.friend-stats{  
  display:grid;  
  grid-template-columns:1fr 1fr;  
  gap:8px;  
  margin-top:8px;  
}  
.friend-stat{  
  background:#fff;  
  border:1px solid var(--line);  
  border-radius:16px;  
  padding:13px;  
  box-shadow:var(--shadow);  
}  
.friend-stat-label{  
  color:var(--muted);  
  font-size:8px;  
  font-weight:800;  
}  
.friend-stat-value{  
  margin-top:5px;  
  font-size:20px;  
  font-weight:950;  
}  
/* =========================  
   PROFILE  
========================= */  
.profile-user{  
  background:#fff;  
  border:1px solid var(--line);  
  border-radius:19px;  
  padding:13px;  
  display:flex;  
  align-items:center;  
  gap:10px;  
  box-shadow:var(--shadow);  
}  
.profile-avatar{  
  width:42px;  
  height:42px;  
  border-radius:14px;  
  background:linear-gradient(145deg,var(--green),var(--green3));  
  color:#fff;  
  display:flex;  
  align-items:center;  
  justify-content:center;  
  font-size:18px;  
  font-weight:950;  
}  
.profile-label{  
  color:var(--muted);  
  font-size:8px;  
  font-weight:800;  
}  
.profile-name{  
  margin-top:4px;  
  font-size:12px;  
  font-weight:950;  
}  
.profile-box{  
  margin-top:8px;  
  background:#fff;  
  border:1px solid var(--line);  
  border-radius:18px;  
  padding:12px;  
  box-shadow:var(--shadow);  
}  
.profile-row{  
  display:flex;  
  justify-content:space-between;  
  gap:10px;  
  padding:7px 0;  
  border-bottom:1px solid #edf1ef;  
}  
.profile-row:last-child{  
  border-bottom:0;  
}  
.profile-row span:first-child{  
  color:var(--muted);  
  font-size:8px;  
  font-weight:800;  
}  
.profile-row span:last-child{  
  font-size:9px;  
  font-weight:900;  
  text-align:right;  
  word-break:break-all;  
}  
.withdraw-box{  
  margin-top:8px;  
  background:#fff;  
  border:1px solid var(--line);  
  border-radius:18px;  
  padding:12px;  
  box-shadow:var(--shadow);  
}  
.withdraw-title{  
  font-size:12px;  
  font-weight:950;  
}  
.withdraw-sub{  
  margin-top:3px;  
  color:var(--muted);  
  font-size:8px;  
}  
.input-wrap{  
  position:relative;  
  margin-top:9px;  
}  
.withdraw-input{  
  width:100%;  
  height:43px;  
  border:1px solid var(--line);  
  border-radius:12px;  
  padding:0 65px 0 12px;  
  outline:none;  
  font-size:11px;  
  font-weight:800;  
  color:var(--ink);  
  background:#f9fbfa;  
}  
.withdraw-input:focus{  
  border-color:#7ac6a5;  
}  
.max-btn{  
  position:absolute;  
  right:6px;  
  top:6px;  
  height:31px;  
  padding:0 9px;  
  border-radius:9px;  
  background:var(--soft);  
  color:var(--green3);  
  font-size:8px;  
  font-weight:950;  
}  
.withdraw-btn{  
  width:100%;  
  height:42px;  
  margin-top:8px;  
  border-radius:12px;  
  background:var(--dark);  
  color:#fff;  
  font-size:10px;  
  font-weight:950;  
}  
.history{  
  margin-top:8px;  
}  
.history-title{  
  font-size:10px;  
  font-weight:950;  
  margin-bottom:6px;  
}  
.history-empty{  
  padding:13px;  
  border-radius:13px;  
  background:#f8faf9;  
  color:var(--muted);  
  font-size:8px;  
  font-weight:700;  
  text-align:center;  
}  
/* =========================  
   WALLET MODAL  
========================= */  
.wallet-panel{  
  position:fixed;  
  left:50%;  
  bottom:74px;  
  transform:translateX(-50%) translateY(20px);  
  width:min(480px,calc(100% - 24px));  
  background:#fff;  
  border:1px solid var(--line);  
  border-radius:21px;  
  padding:13px;  
  box-shadow:0 18px 50px rgba(0,0,0,.18);  
  z-index:100;  
  opacity:0;  
