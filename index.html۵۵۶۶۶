/* =========================================================  
   MINER GRID  
========================================================= */  
  
function renderMinerGrid(){  
  
  const grid =  
    document.getElementById(  
      "minerGrid"  
    );  
  
  
  if(!grid){  
  
    return;  
  
  }  
  
  
  let html =  
    "";  
  
  
  for(  
    let level=1;  
    level<=100;  
    level++  
  ){  
  
    const threshold =  
      levelThreshold(  
        level  
      );  
  
    const rate =  
      levelRate(  
        level  
      );  
  
    const current =  
      level ===  
      state.level;  
  
  
    html += `  
  
      <div  
        class="miner-card ${  
          current  
            ? "current"  
            : ""  
        }">  
  
        <div class="miner-level">  
          LVL ${level}  
        </div>  
  
        <div class="miner-rate">  
          ${rate.toFixed(2)} LNR/h  
        </div>  
  
        <div class="miner-hold">  
          ${threshold.toFixed(0)} LNR claimed  
        </div>  
  
      </div>  
  
    `;  
  
  }  
  
  
  grid.innerHTML =  
    html;  
  
}  
  
  
/* =========================================================  
