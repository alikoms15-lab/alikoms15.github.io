      )
    )
    .run();

  await env.DB
    .prepare(`
      UPDATE withdrawals
      SET
        status = 'failed',
        completed_at =
          CURRENT_TIMESTAMP,
        processed_at =
          CURRENT_TIMESTAMP
      WHERE id = ?
        AND status = 'processing'
    `)
    .bind(
      withdrawal.id
    )
    .run();
}


/* =========================================================
   PROCESS ONE WITHDRAWAL
   ========================================================= */

async function processWithdrawal(
  env,
  withdrawal
) {
  const id =
    Number(
      withdrawal.id
    );

  /*
   * Atomic lock.
   */
  const lock =
    await env.DB
      .prepare(`
        UPDATE withdrawals
        SET
          status = 'processing',
          processing_started_at =
            CURRENT_TIMESTAMP
        WHERE id = ?
          AND status = 'pending'
      `)
      .bind(id)
      .run();

  if (
    !lock?.meta ||
    Number(
      lock.meta.changes || 0
    ) !== 1
  ) {
    return {
      success: false,
      skipped: true,
      withdrawal_id: id
    };
  }

  let broadcasted =
    false;

  let sendInfo =
    null;

  try {

    const payout =
      num(
        withdrawal.payout_amount
      );

    if (
      payout <= 0
    ) {
      throw new Error(
        "INVALID_PAYOUT_AMOUNT"
      );
    }

    if (
      !safeWallet(
        withdrawal.wallet
      )
    ) {
      throw new Error(
        "INVALID_DESTINATION_WALLET"
      );
    }

    const rawAmount =
      rawLnrAmount(
        payout
      );

    await env.DB
      .prepare(`
        UPDATE withdrawals
        SET
          raw_amount = ?,
          jetton_decimals = ?
        WHERE id = ?
      `)
      .bind(
        rawAmount.toString(),
        LNR_DECIMALS,
        id
      )
      .run();

    /*
     * BEFORE BROADCAST:
     * treasury checks.
     */
    try {

      sendInfo =
        await sendLnrFromTreasury(
          env,
          withdrawal.wallet,
          payout,
          id
        );

    } catch (error) {

      await saveWithdrawalError(
        env,
        id,
        "pre_broadcast",
        error,
        {
          payout,
          raw_amount:
            rawAmount.toString(),
          decimals:
            LNR_DECIMALS
        }
      );

      throw error;
    }

    /*
     * From this point the transaction
     * has been sent to the network.
     *
     * NEVER refund automatically
     * after this point.
     */
    broadcasted =
      true;

    await env.DB
      .prepare(`
        UPDATE withdrawals
        SET
          broadcast_at = ?,
          error_stage = NULL,
          error_code = NULL,
          error_message = NULL,
          error_details = ?
        WHERE id = ?
      `)
      .bind(
        sendInfo.broadcastAt,
        JSON.stringify({
          seqno:
            sendInfo.seqno,

          raw_amount:
            sendInfo.rawAmount
              .toString(),

          decimals:
            sendInfo.decimals,

          treasury:
            sendInfo.treasury,

          treasury_jetton_wallet:
            sendInfo.treasuryJettonWallet
        }),
        id
      )
      .run();

    /*
     * Wait for wallet seqno to advance.
     */
    try {

      await waitForSeqnoAdvance(
        env,
        sendInfo.seqno,
        120000
      );

    } catch (error) {

      await saveWithdrawalError(
        env,
        id,
        "confirmation",
        error,
        {
          broadcasted: true,
          seqno:
            sendInfo.seqno
        }
      );

      await markNeedsReview(
        env,
        id,
        error,
        {
          stage:
            "confirmation",

          code:
            "BROADCASTED_CONFIRMATION_TIMEOUT",

          broadcasted: true,

          seqno:
            sendInfo.seqno
        }
      );

      return {
        success: false,
        status:
          "needs_review",
        withdrawal_id:
          id
      };
    }

    /*
     * Give TON Center a moment
     * to index the transaction.
     */
    await new Promise(
      resolve =>
        setTimeout(
          resolve,
          3000
        )
    );

    let txHash =
      null;

    try {

      txHash =
        await findRecentTreasuryTx(
          env,
          sendInfo.seqno
        );

    } catch (error) {

      await saveWithdrawalError(
        env,
        id,
        "tx_lookup",
        error,
        {
          broadcasted: true
        }
      );
    }

    /*
     * Broadcast happened but hash
     * cannot be found:
     * DO NOT REFUND.
     */
    if (!txHash) {

      const error =
        new Error(
          "TX_HASH_NOT_FOUND_AFTER_BROADCAST"
        );

      await markNeedsReview(
        env,
        id,
        error,
        {
          stage:
            "tx_lookup",

          code:
            "TX_HASH_NOT_FOUND",

          broadcasted: true,

          seqno:
            sendInfo.seqno
        }
      );

      return {
        success: false,
        status:
          "needs_review",
        withdrawal_id:
          id
      };
    }

    /*
     * SUCCESS
     */
    await markCompleted(
      env,
      id,
      txHash
    );

    console.log(
      "LNR_WITHDRAWAL_COMPLETED",
      JSON.stringify({
        withdrawal_id:
          id,

        wallet:
          withdrawal.wallet,

        requested:
          withdrawal.requested_amount,

        payout:
          withdrawal.payout_amount,

        raw_amount:
          sendInfo.rawAmount
            .toString(),

        decimals:
          LNR_DECIMALS,

        tx_hash:
          txHash
      })
    );

    return {
      success: true,
      status:
        "completed",

      withdrawal_id:
        id,

      tx_hash:
        txHash
    };

  } catch (error) {

    console.error(
      "LNR_WITHDRAWAL_PROCESS_ERROR",
      JSON.stringify({
        withdrawal_id:
          id,

        broadcasted,

        error:
          readableError(error)
      })
    );

    /*
     * CRITICAL SAFETY:
     * if broadcast happened,
     * never refund automatically.
     */
    if (broadcasted) {

      await saveWithdrawalError(
        env,
        id,
        "post_broadcast",
        error,
        {
          broadcasted: true
        }
      );

      await markNeedsReview(
        env,
        id,
        error,
        {
          stage:
            "post_broadcast",

          code:
            "POST_BROADCAST_UNCERTAIN",

          broadcasted: true
        }
      );

      return {
        success: false,
        status:
          "needs_review",

        withdrawal_id:
          id
      };
    }

    /*
     * NO BROADCAST:
     * safe to refund.
     */
    try {

      await refundWithdrawal(
        env,
        withdrawal
      );

      await saveWithdrawalError(
        env,
        id,
        "pre_broadcast",
        error,
        {
          broadcasted: false,
          refunded: true
        }
      );

      return {
        success: false,
        status:
          "failed",

        refunded: true,

        withdrawal_id:
          id,

        error:
          readableError(error)
      };

    } catch (refundError) {

      await saveWithdrawalError(
        env,
        id,
        "refund",
        refundError,
        {
          original_error:
            readableError(error)
        }
      );

      try {

        await env.DB
          .prepare(`
            UPDATE withdrawals
            SET
              status =
                'needs_review',
              error_stage =
                'refund',
              error_code =
                'REFUND_FAILED',
              error_message = ?,
              error_details = ?
            WHERE id = ?
              AND status =
                'processing'
          `)
          .bind(
            readableError(
              refundError
            ),

            JSON.stringify({
              original_error:
                readableError(error)
            }).slice(
              0,
              10000
            ),

            id
          )
          .run();

      } catch (_) {}

      return {
        success: false,

        status:
          "needs_review",

        refunded:
          false,

        withdrawal_id:
          id
      };
    }
  }
}


/* =========================================================
   PROCESS PENDING WITHDRAWALS
   ========================================================= */

async function processPendingWithdrawals(
  env
) {
  const result =
    await env.DB
      .prepare(`
        SELECT
          id,
          telegram_id,
          wallet,
          requested_amount,
          fee,
          payout_amount,
          status,
          tx_hash,
          created_at
        FROM withdrawals
        WHERE status = 'pending'
        ORDER BY id ASC
        LIMIT 5
      `)
      .all();

  const rows =
    result.results || [];

  const results = [];

  for (
    const withdrawal
    of rows
  ) {

    try {

      const result =
        await processWithdrawal(
          env,
          withdrawal
        );

      results.push(
        result
      );

    } catch (error) {

      console.error(
        "LNR_WITHDRAWAL_UNHANDLED",
        readableError(error)
      );

      results.push({
        success: false,
        status: "error",

        withdrawal_id:
          withdrawal.id,

        error:
          readableError(error)
      });
    }

    /*
     * Avoid hammering TON Center.
     */
    await new Promise(
      resolve =>
        setTimeout(
          resolve,
          1000
        )
    );
  }

  return results;
}


/* =========================================================
   MANUAL PROCESS ENDPOINT
   ========================================================= */

async function handleProcessWithdrawals(
  request,
  env
) {
  const secret =
    String(
      env.LNR_CRON_SECRET ||
      ""
    );

  const supplied =
    String(
      request.headers.get(
        "X-LNR-CRON-SECRET"
      ) ||
      ""
    );

  if (
    !secret ||
    supplied !== secret
  ) {
    return json({
      success: false,
      error:
        "Unauthorized"
    }, 401);
  }

  try {

    const results =
      await processPendingWithdrawals(
        env
      );

    return json({
      success: true,

      processed:
        results.length,

      results
    });

  } catch (error) {

    console.error(
      "PROCESS_WITHDRAWALS_ERROR",
      readableError(error)
    );

    return json({
      success: false,
      error:
        readableError(error)
    }, 500);
  }
}


/* =========================================================
   WITHDRAW REQUEST
   ========================================================= */

async function handleWithdraw(
  request,
  env
) {
  const data =
    await request.json();

  const telegramId =
    String(
      data.telegram_id || ""
    );

  const wallet =
    String(
      data.wallet || ""
    ).trim();

  if (!telegramId)
    return json({
      success: false,
      error:
        "telegram_id is required"
    }, 400);

  if (!wallet)
    return json({
      success: false,
      error:
        "wallet is required"
    }, 400);

  if (
    !safeWallet(wallet)
  ) {
    return json({
      success: false,
      error:
        "Invalid wallet"
    }, 400);
  }

  const user =
    await getUser(
      env,
      telegramId
    );

  if (!user)
    return json({
      success: false,
      error:
        "User not found"
    }, 404);

  /*
   * Withdrawal wallet must match
   * the connected wallet stored for user.
   */
  if (
    user.wallet &&
    String(user.wallet) !==
      wallet
  ) {
    return json({
      success: false,
      error:
        "Withdrawal wallet does not match connected wallet"
    }, 403);
  }

  const amount =
    num(data.amount);

  if (
    !Number.isFinite(amount) ||
    amount <
      CONFIG.WITHDRAWAL_MIN
  ) {
    return json({
      success: false,
      error:
        `Minimum withdrawal is ${CONFIG.WITHDRAWAL_MIN} LNR`
    }, 400);
  }

  const balance =
    num(user.balance);

  if (
    balance < amount
  ) {
    return json({
      success: false,
      error:
        "Insufficient balance"
    }, 400);
  }

  const fee =
    CONFIG.WITHDRAWAL_FEE;

  const net =
    amount - fee;

  if (net <= 0) {
    return json({
      success: false,
      error:
        "Invalid payout amount"
    }, 400);
  }

  try {

    /*
     * Deduct balance first.
     */
    const update =
      await env.DB
        .prepare(`
          UPDATE users
          SET
            balance =
              balance - ?,
            updated_at =
              CURRENT_TIMESTAMP
          WHERE telegram_id = ?
            AND balance >= ?
        `)
        .bind(
          amount,
          telegramId,
          amount
        )
        .run();

    if (
      Number(
        update?.meta?.changes ||
        0
      ) !== 1
    ) {
      return json({
        success: false,
        error:
          "Insufficient balance"
      }, 400);
    }

    /*
     * Record pending withdrawal.
     */
    await env.DB
      .prepare(`
        INSERT INTO withdrawals
        (
          telegram_id,
          wallet,
          requested_amount,
          fee,
          payout_amount,
          amount,
          net_amount,
          status,
          jetton_decimals,
          created_at
        )
        VALUES
        (?, ?, ?, ?, ?, ?, ?, 'pending', ?, CURRENT_TIMESTAMP)
      `)
      .bind(
        telegramId,
        wallet,
        amount,
        fee,
        net,
        amount,
        net,
        LNR_DECIMALS
      )
      .run();

  } catch (error) {

    /*
     * If record creation failed after balance
     * deduction, return the balance.
     */
    try {

      await env.DB
        .prepare(`
          UPDATE users
          SET
            balance =
              balance + ?,
            updated_at =
              CURRENT_TIMESTAMP
          WHERE telegram_id = ?
        `)
        .bind(
          amount,
          telegramId
        )
        .run();

    } catch (_) {}

    return json({
      success: false,
      error:
        readableError(error)
    }, 500);
  }

  const updated =
    await getUser(
      env,
      telegramId
    );

  return json({
    success: true,

    withdrawal: {
      amount,

      requested_amount:
        amount,

      fee,

      net_amount:
        net,

      payout_amount:
        net,

      raw_amount:
        rawLnrAmount(
          net
        ).toString(),

      decimals:
        LNR_DECIMALS,

      status:
        "pending",

      wallet
    },

    user:
      await buildUserPayload(
        env,
        updated
      )
  });
}


/* =========================================================
   REFERRAL API
   ========================================================= */

async function handleReferral(
  request,
  env
) {
  const url =
    new URL(
      request.url
    );

  let telegramId =
    url.searchParams.get(
      "telegram_id"
    );

  if (
    request.method ===
    "POST"
  ) {
    try {
      const data =
        await request.json();

      telegramId =
        String(
          data.telegram_id ||
          telegramId ||
          ""
        );
    } catch (_) {}
  }

  if (!telegramId)
    return json({
      success: false,
      error:
        "telegram_id is required"
    }, 400);

  const user =
    await getUser(
      env,
      telegramId
    );

  if (!user)
    return json({
      success: false,
      error:
        "User not found"
    }, 404);

  return json({
    success: true,

    referral_code:
      user.referral_code,

    referral_link:
      `https://t.me/${CONFIG.BOT_USERNAME}?start=${encodeURIComponent(
        user.referral_code || ""
      )}`,

    successful_referrals:
      Number(
        user.referral_success ||
        0
      ),

    referral_earnings:
      num(
        user.referral_earnings,
        0
      ),

    success_bonus:
      CONFIG.REFERRAL_SUCCESS_BONUS,

    claim_percent:
      CONFIG.REFERRAL_CLAIM_PERCENT
  });
}


/* =========================================================
   WITHDRAWAL HISTORY
   ========================================================= */

async function handleWithdrawals(
  request,
  env
) {
  const url =
    new URL(
      request.url
    );

  const telegramId =
    url.searchParams.get(
      "telegram_id"
    );

  if (!telegramId)
    return json({
      success: false,
      error:
        "telegram_id is required"
    }, 400);

  try {

    const result =
      await env.DB
        .prepare(`
          SELECT
            id,
            wallet,
            requested_amount,
            requested_amount AS amount,
            fee,
            payout_amount,
            payout_amount AS net_amount,
            status,
            tx_hash,
            created_at,
            completed_at,
            completed_at AS processed_at,
            error_stage,
            error_code,
            error_message,
            error_details,
            processing_started_at,
            broadcast_at,
            jetton_decimals,
            raw_amount
          FROM withdrawals
          WHERE telegram_id = ?
          ORDER BY id DESC
          LIMIT 100
        `)
        .bind(
          telegramId
        )
        .all();

    return json({
      success: true,
      withdrawals:
        result.results || []
    });

  } catch (error) {

    return json({
      success: false,
      error:
        readableError(error)
    }, 500);
  }
}


/* =========================================================
   MINERS API
   ========================================================= */

async function handleMiners(
  env
) {
  const levels = [];

  for (
    let level = 1;
    level <= CONFIG.MAX_LEVEL;
    level++
  ) {

    levels.push({
      level,

      required_lnr:
        levelRequiredLNR(
          level
        ),

      mining_rate:
        miningRateForLevel(
          level
        )
    });
  }

  return json({
    success: true,

    max_level:
      CONFIG.MAX_LEVEL,

    level_step_lnr:
      CONFIG.LEVEL_STEP_LNR,

    levels
  });
}


/* =========================================================
   MAIN FETCH
   ========================================================= */

export default {

  async fetch(
    request,
    env
  ) {

    if (
      request.method ===
      "OPTIONS"
    ) {
      return new Response(
        null,
        {
          status: 204,
          headers:
            corsHeaders
        }
      );
    }

    const url =
      new URL(
        request.url
      );

    const path =
      url.pathname;


    /* -----------------------------------------
       ROOT
       ----------------------------------------- */

    if (
      path === "/" &&
      request.method === "GET"
    ) {
      return json({
        success: true,
        app: "LUNARO",
        api: "running",
        version:
          "auto-withdraw-v1"
      });
    }


    /* -----------------------------------------
       HEALTH
       ----------------------------------------- */

    if (
      path === "/health" &&
      request.method === "GET"
    ) {
      return json({
        success: true,

        service:
          "LUNARO API",

        version:
          "auto-withdraw-v1",

        time:
          nowIso()
      });
    }


    /* -----------------------------------------
       CONFIG
       ----------------------------------------- */

    if (
      path === "/config" &&
      request.method === "GET"
    ) {
      return json({
        success: true,

        bot_username:
          CONFIG.BOT_USERNAME,

        max_level:
          CONFIG.MAX_LEVEL,

        level_step_lnr:
          CONFIG.LEVEL_STEP_LNR,

        withdrawal_min:
          CONFIG.WITHDRAWAL_MIN,

        withdrawal_fee:
          CONFIG.WITHDRAWAL_FEE,

        withdrawal_net:
          CONFIG.WITHDRAWAL_NET,

        referral_success_bonus:
          CONFIG.REFERRAL_SUCCESS_BONUS,

        referral_claim_percent:
          CONFIG.REFERRAL_CLAIM_PERCENT,

        lnr_master:
          LNR_MASTER,

        treasury:
          TREASURY_OWNER,

        lnr_decimals:
          LNR_DECIMALS
      });
    }


    /* -----------------------------------------
       PRICE
       ----------------------------------------- */

    if (
      path === "/price" &&
      request.method === "GET"
    ) {
      return json({
        success: true,

        symbol:
          "LNR",

        reference_price_usdt:
          num(
            env.LNR_REFERENCE_PRICE,
            CONFIG.DEFAULT_LNR_PRICE
          ),

        source:
          env.LNR_REFERENCE_PRICE
            ? "env"
            : "reference"
      });
    }


    /*
     * D1 migration.
     */
    try {
      await bestEffortSchema(
        env
      );
    } catch (_) {}


    try {


      /* -----------------------------------------
         USER POST
         ----------------------------------------- */

      if (
        path === "/user" &&
        request.method === "POST"
      ) {
        return await handleUserPost(
          request,
          env
        );
      }


      /* -----------------------------------------
         USER GET
         ----------------------------------------- */

      if (
        path === "/user" &&
        request.method === "GET"
      ) {

        const telegramId =
          url.searchParams.get(
            "telegram_id"
          );

        if (!telegramId)
          return json({
            success: false,
            error:
              "telegram_id is required"
          }, 400);

        const user =
          await getUser(
            env,
            telegramId
          );

        if (!user)
          return json({
            success: false,
            error:
              "User not found"
          }, 404);

        return json({
          success: true,

          user:
            await buildUserPayload(
              env,
              user
            )
        });
      }


      /* -----------------------------------------
         MINE
         ----------------------------------------- */

      if (
        path === "/mine" &&
        request.method === "POST"
      ) {
        return await handleMine(
          request,
          env
        );
      }


      /* -----------------------------------------
         CLAIM
         ----------------------------------------- */

      if (
        path === "/claim" &&
        request.method === "POST"
      ) {
        return await handleClaim(
          request,
          env
        );
      }


      /* -----------------------------------------
         TASK
         ----------------------------------------- */

      if (
        path === "/task" &&
        request.method === "POST"
      ) {
        return await handleTask(
          request,
          env
        );
      }


      /* -----------------------------------------
         WITHDRAW REQUEST
         ----------------------------------------- */

      if (
        path === "/withdraw" &&
        request.method === "POST"
      ) {
        return await handleWithdraw(
          request,
          env
        );
      }


      /* -----------------------------------------
         MANUAL CRON PROCESS
         ----------------------------------------- */

      if (
        path ===
          "/process-withdrawals" &&
        request.method === "POST"
      ) {
        return await handleProcessWithdrawals(
          request,
          env
        );
      }


      /* -----------------------------------------
         REFERRAL
         ----------------------------------------- */

      if (
        path === "/referral" &&
        (
          request.method === "GET" ||
          request.method === "POST"
        )
      ) {
        return await handleReferral(
          request,
          env
        );
      }


      /* -----------------------------------------
         WITHDRAWAL HISTORY
         ----------------------------------------- */

      if (
        path === "/withdrawals" &&
        request.method === "GET"
      ) {
        return await handleWithdrawals(
          request,
          env
        );
      }


      /* -----------------------------------------
         MINERS
         ----------------------------------------- */

      if (
        path === "/miners" &&
        request.method === "GET"
      ) {
        return await handleMiners(
          env
        );
      }


      return json({
        success: false,
        error:
          "Not Found"
      }, 404);


    } catch (error) {

      console.error(
        "LUNARO_API_ERROR",
        readableError(error)
      );

      return json({
        success: false,

        error:
          readableError(error)
      }, 500);
    }
  },


  /* =======================================================
     CLOUDFLARE CRON
     ======================================================= */

  async scheduled(
    event,
    env,
    ctx
  ) {

    ctx.waitUntil(
      (async () => {

        try {

          console.log(
            "LNR_AUTO_WITHDRAW_CRON_START",
            nowIso()
          );

          const results =
            await processPendingWithdrawals(
              env
            );

          console.log(
            "LNR_AUTO_WITHDRAW_CRON_DONE",
            JSON.stringify({
              processed:
                results.length,

              results
            })
          );

        } catch (error) {

          console.error(
            "LNR_AUTO_WITHDRAW_CRON_ERROR",
            readableError(error)
          );
        }

      })()
    );
  }
};
