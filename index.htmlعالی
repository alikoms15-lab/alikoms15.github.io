}


async function refundWithdrawal(
  env,
  withdrawal
) {
  /*
   * This function is ONLY called when
   * no blockchain broadcast happened.
   */

  await env.DB
    .prepare(`
      UPDATE users
      SET
        balance =
          COALESCE(balance,0) + ?,
        updated_at =
          CURRENT_TIMESTAMP
      WHERE telegram_id = ?
    `)
    .bind(
      num(
        withdrawal.requested_amount
      ),
      String(
