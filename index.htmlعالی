  env
) {
  const data =
    await request.json();

  const telegramId =
    String(
      data.telegram_id || ""
    );

  const wallet =
    String(
      data.wallet || ""
    );

  if (!telegramId)
    return json({
      success: false,
      error:
        "telegram_id is required"
    }, 400);

  if (!wallet)
    return json({
      success: false,
      error:
        "wallet is required"
    }, 400);

  const user =
    await getUser(
      env,
      telegramId
    );

  if (!user)
    return json({
      success: false,
      error:
        "User not found"
    }, 404);

  const now =
    Date.now();

  const last =
    user.last_mining_at
      ? new Date(
          user.last_mining_at
        ).getTime()
      : now;

  let elapsed =
    (now - last) /
    1000;

  if (
    !Number.isFinite(elapsed) ||
    elapsed < 0
  ) {
    elapsed = 0;
  }

  elapsed =
    Math.min(
      elapsed,
      86400
    );

  const rate =
    miningRateForLevel(
      Number(
        user.level || 1
      )
    );

  const accrued =
    (elapsed / 3600) *
    rate;

  const claimAmount =
    Number(
      user.mined || 0
    ) + accrued;

  if (
    claimAmount <= 0
  ) {
    return json({
      success: false,
      error:
        "Nothing to claim"
    }, 400);
  }

  const newBalance =
    Number(
      user.balance || 0
    ) + claimAmount;

  await env.DB
    .prepare(`
      UPDATE users
      SET
        wallet = ?,
        balance = ?,
        mined = 0,
        last_mining_at = ?,
        updated_at =
          CURRENT_TIMESTAMP
      WHERE telegram_id = ?
    `)
    .bind(
      wallet,
      newBalance,
      nowIso(),
      telegramId
    )
    .run();

  let claimId =
    null;

  try {

    const inserted =
      await env.DB
        .prepare(`
          INSERT INTO claims
          (
            telegram_id,
            amount
          )
          VALUES (?, ?)
        `)
        .bind(
          telegramId,
          claimAmount
        )
        .run();

    claimId =
      inserted?.meta
        ?.last_row_id ??
      null;

  } catch (_) {}

  try {
    await creditReferralClaimReward(
      env,
      user,
      claimAmount,
      claimId
    );
  } catch (_) {}

  const finalUser =
    await getUser(
      env,
      telegramId
    );

  return json({
    success: true,

    claimed:
      claimAmount,

    user:
      await buildUserPayload(
        env,
        finalUser
      )
  });
}


/* =========================================================
   DAILY TASK
   ========================================================= */

async function handleTask(
  request,
  env
) {
  const data =
    await request.json();

  const telegramId =
    String(
      data.telegram_id || ""
    );

  const taskKey =
    String(
      data.task_key ||
      "daily"
    );

  if (!telegramId)
    return json({
      success: false,
      error:
        "telegram_id is required"
    }, 400);

  const user =
    await getUser(
      env,
      telegramId
    );

  if (!user)
    return json({
      success: false,
      error:
        "User not found"
    }, 404);

  const today =
    new Date()
      .toISOString()
      .slice(0, 10);

  try {

    const existing =
      await env.DB
        .prepare(`
          SELECT id
          FROM daily_tasks
          WHERE telegram_id = ?
            AND task_key = ?
            AND task_date = ?
        `)
        .bind(
          telegramId,
          taskKey,
          today
        )
        .first();

    if (existing) {
      return json({
        success: false,
        error:
          "Task already claimed",
        user:
          await buildUserPayload(
            env,
            user
          )
      }, 400);
    }

    await env.DB
      .prepare(`
        UPDATE users
        SET
          balance =
            COALESCE(balance,0) + ?,
          last_task_date = ?,
          updated_at =
            CURRENT_TIMESTAMP
        WHERE telegram_id = ?
      `)
      .bind(
        CONFIG.DAILY_TASK_REWARD,
        today,
        telegramId
      )
      .run();

    await env.DB
      .prepare(`
        INSERT INTO daily_tasks
        (
          telegram_id,
          task_key,
          task_date,
          reward
        )
        VALUES (?, ?, ?, ?)
      `)
      .bind(
        telegramId,
        taskKey,
        today,
        CONFIG.DAILY_TASK_REWARD
      )
      .run();

  } catch (e) {

    return json({
      success: false,
      error:
        e.message ||
        "Task failed"
    }, 500);
  }

  const updated =
    await getUser(
      env,
      telegramId
    );

  return json({
    success: true,

    reward:
      CONFIG.DAILY_TASK_REWARD,

    user:
      await buildUserPayload(
        env,
        updated
      )
  });
}


/* =========================================================
   WITHDRAWAL HELPERS
   ========================================================= */

function classifyWithdrawalError(
  stage,
  error
) {
  const message =
    readableError(error);

  let code =
    "WITHDRAWAL_ERROR";

  if (
    message.includes(
      "mnemonic"
    )
  ) {
    code =
      "TREASURY_MNEMONIC_ERROR";

  } else if (
    message.includes(
      "Treasury"
    )
  ) {
    code =
      "TREASURY_ERROR";

  } else if (
    message.includes(
      "Jetton"
    )
  ) {
    code =
      "JETTON_ERROR";

  } else if (
    message.includes(
      "balance"
    )
  ) {
    code =
      "BALANCE_ERROR";

  } else if (
    message.includes(
      "seqno"
    )
  ) {
    code =
      "SEQNO_ERROR";

  } else if (
    message.includes(
      "timeout"
    )
  ) {
    code =
      "CONFIRMATION_TIMEOUT";

  } else if (
    message.includes(
      "TON"
    )
  ) {
    code =
      "TON_GAS_ERROR";
  }

  return {
    stage,
    code,
    message
  };
}


async function saveWithdrawalError(
  env,
  id,
  stage,
  error,
  details = {}
) {
  const info =
    classifyWithdrawalError(
      stage,
      error
    );

  try {

    await env.DB
      .prepare(`
        UPDATE withdrawals
        SET
          error_stage = ?,
          error_code = ?,
          error_message = ?,
          error_details = ?
        WHERE id = ?
      `)
      .bind(
        info.stage,
        info.code,
        info.message,
        JSON.stringify(
          details
        ).slice(0, 10000),
        id
      )
      .run();

  } catch (_) {}

  console.error(
    "LNR_WITHDRAWAL_ERROR",
    JSON.stringify({
      withdrawal_id: id,
      ...info,
      details
    })
  );
}


/* =========================================================
   TON CLIENT
   ========================================================= */

function createTonClient(
  env
) {
  return new TonClient({
    endpoint:
      env.TONCENTER_URL ||
      TONCENTER_URL,

    apiKey:
      env.TONCENTER_API_KEY ||
      ""
  });
}


/* =========================================================
   TREASURY
   ========================================================= */

async function getTreasury(
  env
) {
  const mnemonic =
    String(
      env.LNR_TREASURY_MNEMONIC ||
      ""
    ).trim();

  if (!mnemonic) {
    throw new Error(
      "TREASURY_MNEMONIC_MISSING"
    );
  }

  const words =
    mnemonic
      .split(/\s+/)
      .filter(Boolean);

  if (
    words.length < 12
  ) {
    throw new Error(
      "TREASURY_MNEMONIC_INVALID"
    );
  }

  const keyPair =
    await mnemonicToPrivateKey(
      words
    );

  const wallet =
    WalletContractV4.create({
      workchain: 0,
      publicKey:
        keyPair.publicKey
    });

  const configured =
    Address.parse(
      TREASURY_OWNER
    );

  if (
    !wallet.address.equals(
      configured
    )
  ) {
    throw new Error(
      "TREASURY_MNEMONIC_DOES_NOT_MATCH_TREASURY"
    );
  }

  return {
    wallet,
    keyPair
  };
}


/* =========================================================
   JETTON MASTER / TREASURY JETTON WALLET
   ========================================================= */

async function getTreasuryJettonWallet(
  env
) {
  const client =
    createTonClient(
      env
    );

  const masterAddress =
    Address.parse(
      env.LNR_JETTON_MASTER ||
      LNR_MASTER
    );

  const master =
    client.open(
      new JettonMaster(
        masterAddress
      )
    );

  const treasury =
    Address.parse(
      TREASURY_OWNER
    );

  const jettonWallet =
    await master.getWalletAddress(
      treasury
    );

  return {
    client,
    master,
    masterAddress,
    jettonWallet
  };
}


/* =========================================================
   TREASURY BALANCES
   ========================================================= */

async function getTreasuryTonBalance(
  env
) {
  const client =
    createTonClient(
      env
    );

  const balance =
    await client.getBalance(
      Address.parse(
        TREASURY_OWNER
      )
    );

  return Number(balance) /
    1e9;
}


async function getTreasuryLnrBalance(
  env
) {
  const {
    client,
    jettonWallet
  } =
    await getTreasuryJettonWallet(
      env
    );

  try {

    const result =
      await client.runMethod(
        jettonWallet,
        "get_wallet_data"
      );

    const raw =
      result.stack.readBigNumber();

    return {
      raw,
      amount:
        Number(raw) /
        Math.pow(
          10,
          LNR_DECIMALS
        ),

      wallet:
        jettonWallet
          .toString()
    };

  } catch (error) {

    throw new Error(
      "JETTON_BALANCE_READ_FAILED: " +
      readableError(error)
    );
  }
}


/* =========================================================
   JETTON TRANSFER BODY
   ========================================================= */

function buildJettonTransferBody(
  destination,
  responseDestination,
  amountRaw,
  queryId
) {
  return beginCell()

    /*
     * op::transfer
     */
    .storeUint(
      0x0f8a7ea5,
      32
    )

    .storeUint(
      queryId,
      64
    )

    .storeCoins(
      amountRaw
    )

    .storeAddress(
      destination
    )

    .storeAddress(
      responseDestination
    )

    /*
     * custom_payload = null
     */
    .storeBit(0)

    /*
     * forward_ton_amount
     */
    .storeCoins(
      BigInt(
        Math.round(
          FORWARD_TON *
          1e9
        )
      )
    )

    /*
     * forward_payload = empty
     */
    .storeBit(0)

    .endCell();
}


/* =========================================================
   SEND LNR
   ========================================================= */

async function sendLnrFromTreasury(
  env,
  destination,
  amount,
  withdrawalId
) {
  if (
    !safeWallet(destination)
  ) {
    throw new Error(
      "INVALID_DESTINATION_WALLET"
    );
  }

  const destinationAddress =
    Address.parse(
      destination
    );

  const {
    wallet,
    keyPair
  } =
    await getTreasury(
      env
    );

  const client =
    createTonClient(
      env
    );

  const tonBalance =
    await getTreasuryTonBalance(
      env
    );

  if (
    tonBalance <
    MIN_TREASURY_TON
  ) {
    throw new Error(
      `INSUFFICIENT_TREASURY_TON:${tonBalance}`
    );
  }

  const treasuryLnr =
    await getTreasuryLnrBalance(
      env
    );

  const rawAmount =
    rawLnrAmount(
      amount
    );

  if (
    treasuryLnr.raw <
    rawAmount
  ) {
    throw new Error(
      `INSUFFICIENT_TREASURY_LNR:required=${rawAmount.toString()}:available=${treasuryLnr.raw.toString()}`
    );
  }

  const {
    jettonWallet
  } =
    await getTreasuryJettonWallet(
      env
    );

  const openedWallet =
    client.open(
      wallet
    );

  const seqno =
    await openedWallet.getSeqno();

  const body =
    buildJettonTransferBody(
      destinationAddress,
      wallet.address,
      rawAmount,
      BigInt(
        withdrawalId
      )
    );

  await openedWallet.sendTransfer({
    seqno,

    secretKey:
      keyPair.secretKey,

    sendMode:
      SendMode.PAY_GAS_SEPARATELY,

    messages: [
      internal({
        to:
          jettonWallet,

        value:
          BigInt(
            Math.round(
              MIN_TREASURY_TON *
              1e9
            )
          ),

        bounce:
          true,

        body
      })
    ]
  });

  return {
    seqno,

    rawAmount,

    decimals:
      LNR_DECIMALS,

    treasury:
      wallet.address.toString(),

    treasuryJettonWallet:
      jettonWallet.toString(),

    destination,

    broadcastAt:
      nowIso()
  };
}


/* =========================================================
   WAIT FOR TREASURY SEQNO
   ========================================================= */

async function waitForSeqnoAdvance(
  env,
  previousSeqno,
  timeoutMs = 120000
) {
  const started =
    Date.now();

  while (
    Date.now() -
    started <
    timeoutMs
  ) {

    try {

      const {
        wallet
      } =
        await getTreasury(
          env
        );

      const client =
        createTonClient(
          env
        );

      const current =
        await client.open(
          wallet
        ).getSeqno();

      if (
        current >
        previousSeqno
      ) {
        return current;
      }

    } catch (_) {}

    await new Promise(
      resolve =>
        setTimeout(
          resolve,
          5000
        )
    );
  }

  throw new Error(
    "CONFIRMATION_TIMEOUT"
  );
}


/* =========================================================
   FIND TX HASH
   ========================================================= */

async function findRecentTreasuryTx(
  env,
  previousSeqno
) {
  const apiKey =
    env.TONCENTER_API_KEY ||
    "";

  const response =
    await fetch(
      env.TONCENTER_URL ||
      TONCENTER_URL,
      {
        method: "POST",

        headers: {
          "Content-Type":
            "application/json",

          ...(apiKey
            ? {
                "X-API-Key":
                  apiKey
              }
            : {})
        },

        body:
          JSON.stringify({
            jsonrpc: "2.0",
            id: Date.now(),

            method:
              "getTransactions",

            params: {
              address:
                Address.parse(
                  TREASURY_OWNER
                ).toRawString(),

              limit: 10
            }
          })
      }
    );

  if (!response.ok) {
    throw new Error(
      `TONCENTER_HTTP_${response.status}`
    );
  }

  const data =
    await response.json();

  if (data.error) {
    throw new Error(
      data.error.message ||
      "TONCENTER_RPC_ERROR"
    );
  }

  const transactions =
    data.result || [];

  if (
    !Array.isArray(
      transactions
    )
  ) {
    return null;
  }

  for (
    const tx of transactions
  ) {

    const hash =
      tx?.transaction_id?.hash;

    if (hash) {
      return hash;
    }
  }

  return null;
}


